{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "api/Dockerfile",
    "watchPatterns": ["api/**"]
  },
  "deploy": {
    "preDeployCommand": ["bun run migrate"],
    "startCommand": "bun run start",
    "healthcheckPath": "/api/healthz"
  }
}
